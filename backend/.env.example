# Copie ce fichier en .env pour le developpement local (jamais commite).
# En production (Railway), ces valeurs sont definies comme variables
# d'environnement du service, jamais dans le code ni dans le repo.

# Fournie automatiquement par le plugin Postgres de Railway.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Origines autorisees a appeler l'API (separees par des virgules).
# Exemple : https://ali686583.github.io
ALLOWED_ORIGINS=http://localhost:8000

# URL publique du frontend, utilisee pour construire le lien envoye par
# email lors d'une reinitialisation de mot de passe.
FRONTEND_URL=http://localhost:8000

# Resend (https://resend.com) pour l'envoi de l'email "mot de passe oublie".
# Railway bloque le SMTP sortant sur les plans Free/Trial/Hobby, d'ou l'usage
# d'une API HTTPS plutot que d'un serveur SMTP classique.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Duree de vie des sessions et des tokens de reinitialisation.
SESSION_TTL_DAYS=7
RESET_TOKEN_TTL_MINUTES=30

# Mettre a "false" seulement en dev local sans HTTPS (desactive le flag
# Secure du cookie de session). Toujours "true" en production.
COOKIE_SECURE=true

PORT=8080
