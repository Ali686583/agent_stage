# Copie ce fichier en .env pour le developpement local (jamais commite).
# En production (Railway), ces valeurs sont definies comme variables
# d'environnement du service, jamais dans le code ni dans le repo.

# Fournie automatiquement par le plugin Postgres de Railway.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Stockage partage du rate limiter (obligatoire, voir librairies/rate_limit.py) ;
# sert aussi au Pub/Sub temps reel et aux jobs en arriere-plan des phases
# suivantes. Fourni par le service Redis de Railway.
REDIS_URL=redis://:password@localhost:6379/0

# URL publique du service (le meme sert le frontend et l'API), utilisee
# pour construire le lien envoye par email lors d'une reinitialisation de
# mot de passe. Exemple en production : https://backend-production-xxxx.up.railway.app
FRONTEND_URL=http://localhost:8080

# Brevo (https://www.brevo.com) pour l'envoi de l'email "mot de passe oublie".
# Railway bloque le SMTP sortant sur les plans Free/Trial/Hobby, d'ou l'usage
# d'une API HTTPS plutot que d'un serveur SMTP classique. BREVO_SENDER_EMAIL
# doit etre un expediteur verifie dans le compte Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=agent_stage

# Duree de vie des sessions et des tokens de reinitialisation.
SESSION_TTL_DAYS=7
RESET_TOKEN_TTL_MINUTES=30

# Mettre a "false" seulement en dev local sans HTTPS (desactive le flag
# Secure du cookie de session). Toujours "true" en production.
COOKIE_SECURE=true

PORT=8080
